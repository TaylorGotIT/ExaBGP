
[exabgp.api]
ack = true
chunk = 1
cli = true
compact = false
encoder = text
pipename = 'exabgp'
respawn = true
terminate = false

[exabgp.bgp]
openwait = 60
passive = false

[exabgp.cache]
attributes = true
nexthops = true

[exabgp.daemon]
daemonize = false
drop = false
pid = ''
umask = '0o137'
user = 'root'

[exabgp.log]
all = false
configuration = true
daemon = true
destination = 'stdout'
enable = true
level = INFO
message = false
network = true
packets = false
parser = false
processes = true
reactor = true
rib = false
routes = true
short = true
statistics = true
timers = false

[exabgp.profile]
enable = false
file = ''

[exabgp.reactor]
speed = 0.5

[exabgp.tcp]
acl = false
attempts = 0
bind = ''
delay = 0
once = false
port = 179
