[Unit]
Description=ExaBGP v6 BGP daemon
After=network-online.target exabgp-v6-engine.service
Wants=network-online.target
Requires=exabgp-v6-engine.service

[Service]
Type=simple
WorkingDirectory=/exabgp
Environment=INSTALL_DIR=/exabgp
Environment=EXABGP_ENV=/etc/exabgp/exabgp.env
ExecStart=/exabgp/run-exabgp.sh
Restart=always
RestartSec=3

# 引擎在分组/源变更后自动重生成 exabgp.conf 并向 /run/exabgp/exabgp.pid 发 SIGHUP 热重载
# exabgp 意外退出时由本 unit 自动拉起

[Install]
WantedBy=multi-user.target
