[Unit]
Description=ExaBGP Route Injector (web console on :9550)
Documentation=https://github.com/TaylorGotIT/ExaBGP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/exabgp-injector/env
ExecStart=/opt/exabgp-injector/run.sh
Restart=always
RestartSec=3
# BGP 179 需要特权端口；也可改成专用用户 + AmbientCapabilities
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
